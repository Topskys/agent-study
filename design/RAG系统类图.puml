@startuml
!theme plain
skinparam defaultFontName Microsoft YaHei
skinparam packageStyle rectangle
skinparam classBackgroundColor #F8F9FA
skinparam classBorderColor #4A90D9
skinparam arrowColor #333333

title RAG 系统类图（P0 极简版）

' ==================== 当前实现 ====================
package "rag/basic_rag.py (当前实现)" as CURRENT {
  class BasicRAG {
    + api_key: str
    + embed_model: str
    + llm_model: str
    + chunk_size: int
    + chunk_overlap: int
    - chunks: List[Dict]
    --
    + index_file(file_path: str) -> int
    + index_text(text: str, metadata: dict) -> int
    + search(query: str, top_k: int) -> List[Dict]
    + query(query: str, top_k: int) -> Dict
    + clear()
    - _embed(texts: List[str]) -> ndarray
    - _chunk(text: str) -> List[str]
    - _llm_call(messages: List[Dict]) -> str
    - _infer_embed_url(llm_url: str) -> str
  }
}

' ==================== 后续优化 ====================
package "后续优化 (P1/P2)" as FUTURE {
  class LoaderFactory {
    + get_loader(file_path: str) -> BaseLoader
  }

  class BaseChunker <<abstract>> {
    + chunk(doc: RawDocument) -> Chunk[]
  }

  class BaseEmbedder <<abstract>> {
    + embed(texts: List[str]) -> List[vector]
  }

  class BaseVectorStore <<abstract>> {
    + search(collection: str, vec: List, top_k: int) -> List[SearchResult]
  }

  class HybridRetriever {
    + retrieve(query: str) -> List[SearchResult]
  }

  class Reranker {
    + rerank(query: str, results: List) -> List[SearchResult]
  }

  class SelfRAG {
    + need_retrieve(query: str) -> bool
  }
}

