{
  "intents": [
    {
      "name": "phone_recharge",
      "desc": "为指定手机号充值指定金额的话费",
      "priority": 1,
      "keywords": ["充值", "话费", "交话费", "充话费", "充"],
      "required_slots": ["phone_number", "recharge_amount"],
      "optional_slots": [],
      "slots": [
        {
          "slot": "phone_number",
          "slot_desc": "充值手机号",
          "required": true,
          "regex": "^1[0-9]{10}$"
        },
        {
          "slot": "recharge_amount",
          "slot_desc": "充值金额（元）",
          "required": true,
          "regex": "^[1-9][0-9]*([.][0-9]+)?$"
        }
      ]
    },
