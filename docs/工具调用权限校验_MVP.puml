@startuml
' 全局样式
skinparam class {
    BackgroundColor #f8f9fa
    BorderColor #2c3e50
    ArrowColor #34495e
    FontName "Microsoft Yahei"
}
skinparam enum {
    BackgroundColor #e8f4f8
    BorderColor #2980b9
}

' 枚举定义
enum PermissionLevel {
    READ_ONLY
    LOW_RISK
    HIGH_RISK
    FORBIDDEN
}

enum AgentRole {
    CUSTOMER_SERVICE
    FINANCE_STAFF
    ADMIN
}

' 数据类
class ToolCallRequest {
    + tool_name: str
    + tool_params: Dict
    + agent_role: AgentRole
    + user_id: str
    + request_id: str
    + timestamp: datetime
    --
    + __post_init__(): None
}

class ToolCallResult {
    + request_id: str
    + allowed: bool
    + reason: str
    + execution_time: datetime
    + output: Optional[Dict]
    --
    + __post_init__(): None
}

' 核心权限校验类
class PermissionValidator {
    - TOOL_RISK_LEVEL: Dict[str, PermissionLevel]
    - ROLE_TOOL_PERMISSIONS: Dict[AgentRole, Set[str]]
    - TOOL_PARAM_WHITELIST: Dict[str, Set[str]]
    --
    + validate_role_permission(request: ToolCallRequest): bool
    + validate_tool_params(request: ToolCallRequest): bool
    + validate_risk_level(request: ToolCallRequest): bool
    + validate(request: ToolCallRequest): ToolCallResult
}

' 工具执行类
class ToolExecutor {
    - audit_log: List[ToolCallResult]
    --
    + execute(request: ToolCallRequest): ToolCallResult
    - _sandbox_execute(request: ToolCallRequest): Dict
}

' 关系定义
PermissionValidator --> PermissionLevel : 依赖
PermissionValidator --> AgentRole : 依赖
PermissionValidator --> ToolCallRequest : 校验
ToolExecutor --> PermissionValidator : 调用
ToolExecutor --> ToolCallRequest : 接收
ToolExecutor --> ToolCallResult : 返回
ToolExecutor *-- ToolCallResult : 包含审计日志
@enduml
