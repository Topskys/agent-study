# RAG 系统环境变量配置（GitHub Models 版）
# 复制此文件为 .env 后填入实际值

# GitHub Personal Access Token（必填，需 models 权限）
# 创建地址: https://github.com/settings/tokens
OPENAI_API_KEY=ghp_你的github_token

# LLM 接口地址（必填）
OPENAI_BASE_URL=https://models.github.ai/inference/chat/completions

# 向量化接口地址（可选，默认从 BASE_URL 推断）
# EMBED_BASE_URL=https://models.github.ai/inference/embeddings

# 向量化模型（GitHub Models 上的模型名）
EMBED_MODEL=openai/text-embedding-3-small

# LLM 模型名（GitHub Models 上的模型名）
LLM_MODEL=openai/gpt-4o-mini
